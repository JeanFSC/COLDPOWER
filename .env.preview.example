# ==========================================================================
# ColdPower - Variables para DEPLOY PREVIEW PRIVADO (ejemplo)
# --------------------------------------------------------------------------
# - Este archivo es SOLO un ejemplo de referencia.
# - NO contiene datos reales (los valores son placeholder de prueba).
# - NO usar para producción real.
# - En PRODUCCIÓN, NEXT_PUBLIC_ALLOW_PLACEHOLDER_COMPANY_DATA debe ser `false`
#   y NEXT_PUBLIC_IS_PREVIEW debe ser `false` (ver docs/deployment.md).
# - No subir un .env real al repositorio. Configura estos valores en el panel
#   de variables de entorno de Vercel (scope: Preview).
# ==========================================================================

# --- Sitio (preview, NO dominio final) ---
NEXT_PUBLIC_SITE_URL=https://coldpower-preview.vercel.app
NEXT_PUBLIC_COMPANY_NAME=ColdPower

# --- Datos comerciales (PLACEHOLDER de prueba, permitidos solo en preview) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999
NEXT_PUBLIC_CONTACT_EMAIL=ventas@coldpower.pe
NEXT_PUBLIC_CONTACT_PHONE=+51 999 999 999
NEXT_PUBLIC_RUC=00000000000

# --- Modo preview: placeholders permitidos + banner visible ---
NEXT_PUBLIC_ALLOW_PLACEHOLDER_COMPANY_DATA=true
NEXT_PUBLIC_IS_PREVIEW=true

# --- Redes sociales: vacías => no se renderizan enlaces mock ---
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# --- API de cotización (temporal, sin persistencia) ---
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MS=600000
QUOTE_ENABLE_API_LOG=false
