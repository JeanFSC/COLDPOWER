# ColdPower environment template. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://coldpower.pe
NEXT_PUBLIC_COMPANY_NAME=ColdPower
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_TRADE_NAME=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_RUC=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_ALLOW_PLACEHOLDER_COMPANY_DATA=false
NEXT_PUBLIC_IS_PREVIEW=true

QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MS=600000
QUOTE_ENABLE_API_LOG=true
WHATSAPP_RATE_LIMIT_MAX=5
WHATSAPP_RATE_LIMIT_WINDOW_MS=600000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=

# Temporary local-only dashboard QA bypass. Never configure in production.
CP_DEV_AUTH_BYPASS=false
CP_DEV_AUTH_USER_ID=
CP_DEV_AUTH_ALLOWED_HOSTS=localhost:3000

# Required for migrations, catalog import, public catalog queries and quote persistence.
DATABASE_URL=

# Compra online (CP-060)
# PAYMENT_PROVIDER=mock activa la pasarela de prueba (nunca cobra). Vacio = sin pasarela.
PAYMENT_PROVIDER=
# Secreto HMAC para firmar/verificar eventos de la pasarela de prueba.
MOCK_PAYMENT_WEBHOOK_SECRET=
# TRACKING_PROVIDER=mock activa el transportista de prueba.
TRACKING_PROVIDER=
# Minutos que se reserva el stock de un pedido impago (default 30).
ORDER_PAYMENT_TTL_MIN=30
# Bearer para POST /api/internal/cron/pedidos-expirados.
CRON_SECRET=
# Opcional: origen interno para que la pasarela de prueba llame al webhook.
INTERNAL_APP_URL=
