# ==========================================================================
# ColdPower - Variables de entorno (ejemplo)
# --------------------------------------------------------------------------
# IMPORTANTE: Los valores de abajo son PLACEHOLDER de desarrollo/preview.
# NO los uses tal cual en producción real. Reemplázalos por datos reales
# antes de publicar (ver "Datos reales obligatorios antes de producción"
# en docs/deployment.md y docs/deploy-preview-checklist.md).
# No subas .env.local con datos reales al repositorio.
# ==========================================================================

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://coldpower.pe
NEXT_PUBLIC_COMPANY_NAME=ColdPower

# --- Datos comerciales (PLACEHOLDER - reemplazar por reales en producción) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999
NEXT_PUBLIC_CONTACT_EMAIL=ventas@coldpower.pe
NEXT_PUBLIC_CONTACT_PHONE=+51 999 999 999
NEXT_PUBLIC_RUC=00000000000

# --- Redes sociales (opcionales) ---
# Déjalas vacías si aún no existen perfiles reales: NO se renderizarán enlaces mock.
# Configúralas solo con URLs reales antes de mostrar redes en producción.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# --- Protección de datos placeholder ---
# Default seguro: en producción mantén este flag en `false`.
# Si quedan datos placeholder críticos (WhatsApp, email, teléfono, RUC) y este
# flag es `false`, el build/arranque en producción fallará de forma controlada.
# Ponlo en `true` SOLO para un preview privado intencional con datos aún mock.
NEXT_PUBLIC_ALLOW_PLACEHOLDER_COMPANY_DATA=false

# Marca explícita de entorno preview (opcional). No afecta la UI pública.
NEXT_PUBLIC_IS_PREVIEW=true

# --- API de cotización (temporal, sin persistencia) ---
QUOTE_RATE_LIMIT_MAX=5
QUOTE_RATE_LIMIT_WINDOW_MS=600000
QUOTE_ENABLE_API_LOG=true
